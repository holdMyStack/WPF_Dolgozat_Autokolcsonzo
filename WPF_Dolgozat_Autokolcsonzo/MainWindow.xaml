<Window x:Class="WPF_Dolgozat_Autokolcsonzo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Dolgozat_Autokolcsonzo"
        mc:Ignorable="d"
        Title="MainWindow" Height="770" Width="500" ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="8">
            <TextBlock Text="Autókölcsönző" FontFamily="Impact" FontSize="32" HorizontalAlignment="Center" Margin="0,48" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <TextBlock Grid.Column="1" Text="Ügyfél" Margin="8,0" />
                <Separator Grid.Column="2" />
            </Grid>

            <TextBlock Text="Név" />
            <TextBox x:Name="inputName" Margin="0,0,0,8" />

            <TextBlock Text="Életkor" />
            <TextBox x:Name="inputAge" Margin="0,0,0,8" />

            <TextBlock Text="Jogosítvány szám" />
            <TextBox x:Name="inputLicenseNumber" Margin="0,0,0,8" />

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <TextBlock Grid.Column="1" Text="Bérlés" Margin="8,0" />
                <Separator Grid.Column="2" />
            </Grid>

            <ComboBox x:Name="comboCarModel" Margin="0,0,0,8">
                <ComboBoxItem Content="--- Válasszon autómodellt ---" IsSelected="True" IsEnabled="False" />
                <ComboBoxItem Content="Suzuki Swift - 12 000 Ft / nap" />
                <ComboBoxItem Content="Toyota Corolla - 18 000 Ft / nap" />
                <ComboBoxItem Content="BMW 3 - 30 000 Ft / nap" />
                <ComboBoxItem Content="Tesla Model 3 - 35 000 Ft / nap" />
            </ComboBox>

            <TextBlock Text="Bérlés időtartama" />
            <TextBox x:Name="inputRentalLength" Margin="0,0,0,8" />

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <TextBlock Grid.Column="1" Text="Biztosítás" Margin="8,0" />
                <Separator Grid.Column="2" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="radioInsuranceBase" GroupName="biztositas" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Alap biztosítás" />
                        <TextBlock Text="Ingyenes" FontSize="10" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="radioInsuranceExtra" GroupName="biztositas" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Extra biztosítás" />
                        <TextBlock Text="+3 000 Ft / nap" FontSize="10" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="radioInsuranceFull" GroupName="biztositas" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Teljes biztosítás" />
                        <TextBlock Text="+6 000 Ft / nap" FontSize="10" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <TextBlock Grid.Column="1" Text="Extra szolgáltatások" Margin="8,0" />
                <Separator Grid.Column="2" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="checkGPS" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="GPS" />
                        <TextBlock Text="+1 000 Ft / nap" FontSize="10" />
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="checkSeat" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Gyerekülés" />
                        <TextBlock Text="+1 500 Ft / nap" FontSize="10" />
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="checkDriver" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Extra sofőr" />
                        <TextBlock Text="+2 500 Ft / nap" FontSize="10" />
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="checkSticker" Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="Autópálya matrica" />
                        <TextBlock Text="+5 000 Ft" FontSize="10" />
                    </StackPanel>
                </CheckBox>
            </Grid>

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Separator Grid.Column="0" />
                <TextBlock Grid.Column="1" Text="Fizetés" Margin="8,0" />
                <Separator Grid.Column="2" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="radioPayCash" GroupName="fizetesiMod" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Készpénz" />
                        <TextBlock Text="Kereskedésünkben, forintban fizetve" FontSize="10" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="radioPayCard" GroupName="fizetesiMod" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Bankkártya" />
                        <TextBlock Text="Mastercard / Visa / PayPal" FontSize="10" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <CheckBox x:Name="checkTerms" Content="Elolvastam, és elfogadom a fizetési feltételeket." Margin="0,32,0,4" />

            <Button Padding="0,8" Content="Fizetés" Click="Purchase_Clicked" />
        </StackPanel>
    </Grid>
</Window>
